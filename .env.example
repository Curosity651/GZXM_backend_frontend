DATABASE_USERNAME=gzxm
DATABASE_PASSWORD=change-this-local-password
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=change-this-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
FILE_PROVIDER=WEBDAV
FILE_STORAGE_ROOT=./backend/storage/files
